# MySQL (로컬 8.0, price_app 계정만 사용 — root 금지)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=price_app
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=computer_price

# MySQL 커넥션 풀 (API 프로세스 전용 — 크롤러/파이프라인은 풀을 쓰지 않는다)
# 값의 근거는 scripts/perf/RESULTS.md 의 부하 측정 결과에 있다.
DB_POOL_SIZE=20        # 최대 커넥션 수. 20 을 넘겨도 처리량·지연이 개선되지 않는다
DB_POOL_MIN_CACHED=5   # 기동 시 미리 열 수(1개당 350ms 직렬). 측정 시엔 DB_POOL_SIZE 와 같게

# Slack (알림용, 비워두면 Slack 알림 건너뜀)
SLACK_WEBHOOK_URL=

# Dashboard
DASH_DEBUG=false
